\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Hyperparameters used for each method across all standalone target-network benchmarks. Learning rates for \textbf  {Adam}, \textbf  {SGD}, \textbf  {FNG}, \textbf  {OGD}, and \textbf  {FOPNG} are taken from \citet  {garg_fisher-orthogonal_2026} Table~1; \textbf  {iFOPNG} uses identical values to \textbf  {FOPNG}. \textbf  {ONG} learning rates were selected empirically, as \textbf  {ONG} is not evaluated in the original work. \textbf  {EWC} learning rates were selected empirically for Permuted-MNIST and Split-CIFAR10; Split-MNIST and Split-CIFAR100 follow \citet  {garg_fisher-orthogonal_2026}. The damping $\lambda $ is shared across \textbf  {ONG}, \textbf  {FNG}, \textbf  {FOPNG}, and \textbf  {iFOPNG}; \textbf  {OGD} requires no damping. $^\ddagger $CIFAR-100 EWC: \citet  {garg_fisher-orthogonal_2026} report $\lambda _{\mathrm  {EWC}}=50$; this value produced collapsed runs in our replication and $\lambda _{\mathrm  {EWC}}=10$ is used instead. }}{49}{table.caption.45}\protected@file@percent }
\newlabel{tab:hparams_standalone}{{2}{49}{Hyperparameters used for each method across all standalone target-network benchmarks. Learning rates for \textbf {Adam}, \textbf {SGD}, \textbf {FNG}, \textbf {OGD}, and \textbf {FOPNG} are taken from \citet {garg_fisher-orthogonal_2026} Table~1; \textbf {iFOPNG} uses identical values to \textbf {FOPNG}. \textbf {ONG} learning rates were selected empirically, as \textbf {ONG} is not evaluated in the original work. \textbf {EWC} learning rates were selected empirically for Permuted-MNIST and Split-CIFAR10; Split-MNIST and Split-CIFAR100 follow \citet {garg_fisher-orthogonal_2026}. The damping $\lambda $ is shared across \textbf {ONG}, \textbf {FNG}, \textbf {FOPNG}, and \textbf {iFOPNG}; \textbf {OGD} requires no damping. $^\ddagger $CIFAR-100 EWC: \citet {garg_fisher-orthogonal_2026} report $\lambda _{\mathrm {EWC}}=50$; this value produced collapsed runs in our replication and $\lambda _{\mathrm {EWC}}=10$ is used instead}{table.caption.45}{}}
