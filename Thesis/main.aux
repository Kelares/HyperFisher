\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {iFOPNG vs.\ FOPNG across eight benchmarks (Sub-RQ3).} Grouped bars show mean average accuracy; circles show individual seeds; error bars show $\pm 1$ standard deviation. The dashed vertical line separates standalone (left) from hypernetwork (right) settings. \texttt  {iFOPNG} uses the combined metric $F_c = F_\mathrm  {new} + F_\mathrm  {old}$; \texttt  {FOPNG} uses only $F_\mathrm  {new}$. }}{24}{figure.caption.28}\protected@file@percent }
\newlabel{fig:ifopng_comparison}{{5}{24}{\textbf {iFOPNG vs.\ FOPNG across eight benchmarks (Sub-RQ3).} Grouped bars show mean average accuracy; circles show individual seeds; error bars show $\pm 1$ standard deviation. The dashed vertical line separates standalone (left) from hypernetwork (right) settings. \texttt {iFOPNG} uses the combined metric $F_c = F_\mathrm {new} + F_\mathrm {old}$; \texttt {FOPNG} uses only $F_\mathrm {new}$}{figure.caption.28}{}}
